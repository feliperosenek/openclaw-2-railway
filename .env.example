# Required: shared secret for Gateway / Control UI
# On Railway templates use: OPENCLAW_GATEWAY_TOKEN=${{secret(32)}}
OPENCLAW_GATEWAY_TOKEN=

# Listen port (must match Railway HTTP Proxy / public networking)
OPENCLAW_GATEWAY_PORT=8080

# Persistent paths (Railway volume mounted at /data)
OPENCLAW_STATE_DIR=/data/.openclaw
OPENCLAW_WORKSPACE_DIR=/data/workspace
OPENCLAW_CONFIG_DIR=/data/.openclaw
OPENCLAW_CONFIG_PATH=/data/.openclaw/openclaw.json
OPENCLAW_GATEWAY_BIND=lan

# Optional: pin image at build time (default 2026.9.5 = OpenClaw 2.0 line)
# OPENCLAW_VERSION=2026.9.5
